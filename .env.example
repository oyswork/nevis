# Copy to .env to override docker-compose defaults (local development only).
# The database name and credentials apply only when the data directory is created (the first
# `just up`, or after `just clean`): changed later, they no longer match the existing database.
# POSTGRES_USER=nevis
# POSTGRES_PASSWORD=nevis
# POSTGRES_DB=nevis
# The dev database's port on the host:
# POSTGRES_PORT=5432
# Optional: the summary worker (not the api) summarizes documents with a locally running model
# (OpenAI-compatible API). Set both or neither; without them the worker idles and summaries stay
# null. From the worker container, a model on the host is at host.docker.internal, e.g.:
# NEVIS_SUMMARY_API_URL=http://host.docker.internal:11434/v1
# NEVIS_SUMMARY_MODEL=llama3.2
# Optional: rerank document search results with a cross-encoder (off by default; the model is
# already in the image, so turning it on needs no download). Adds roughly 100-200 ms per search.
# NEVIS_SEARCH_RERANK=true
