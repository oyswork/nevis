# Copy to .env to override docker-compose defaults (local development only).
POSTGRES_USER=nevis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nevis
POSTGRES_PORT=5432
MEILI_MASTER_KEY=change-me-at-least-16-bytes
MEILI_PORT=7700
# Optional: summarize documents with a locally running model (OpenAI-compatible API). Set both
# or neither. From the api container, a model on the host is at host.docker.internal, e.g.:
# NEVIS_SUMMARY_API_URL=http://host.docker.internal:11434/v1
# NEVIS_SUMMARY_MODEL=llama3.2
