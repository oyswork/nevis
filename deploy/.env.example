# Production settings: copy to /opt/nevis/.env on the server, chmod 600 (deploy/bootstrap.md).
# Values containing `$` (the password hash) must be single-quoted: compose expands `$` otherwise.

# The machine's static public IPv4 address: the site address and the certificate's subject.
NEVIS_PUBLIC_IP=203.0.113.10

# Where the release images live: ghcr.io/<GitHub owner, lowercase>.
NEVIS_IMAGE_PREFIX=ghcr.io/your-github-user

# Letters and digits only: it goes into connection URLs unencoded. Generate with:
#   openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=change-me

# Credentials for the API. Hash with:
#   docker run --rm caddy:2.11.7 caddy hash-password --plaintext 'the password'
NEVIS_BASIC_AUTH_USER=nevis
NEVIS_BASIC_AUTH_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'

# Optional: summaries from a model running on the host (OpenAI-compatible API); set both.
# NEVIS_SUMMARY_API_URL=http://host.docker.internal:11434/v1
# NEVIS_SUMMARY_MODEL=llama3.2
# Optional: cross-encoder reranking of document search.
# NEVIS_SEARCH_RERANK=true

# Managed by deploy.sh: the release that is running.
NEVIS_IMAGE_TAG=0.0.0
